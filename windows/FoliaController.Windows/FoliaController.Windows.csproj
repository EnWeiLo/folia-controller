<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target brings the WinRT media-session API (SMTC) into C#. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FoliaController</RootNamespace>
    <AssemblyName>FoliaController</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Product>Folia 控制器</Product>
    <AssemblyTitle>Folia 控制器</AssemblyTitle>
    <Version>1.0.0</Version>

    <!-- One self-contained exe: no .NET install needed on the target PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\*" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- Folia's web build, zipped by CI (see .github/workflows/build.yml). -->
    <EmbeddedResource Include="folia.zip" LogicalName="folia.zip" Condition="Exists('folia.zip')" />
  </ItemGroup>

</Project>
